/target
**/*.rs.bk

# Intermediate CUDA cubin: a transient build artifact of scripts/build-fatbin.bat.
# The committed, embedded (include_bytes!) artifact is src/kernels/sha256d.fatbin,
# which already contains this cubin; the standalone .cubin is regenerated on each
# fatbin build, so it is not tracked.
src/kernels/*.cubin
# Cargo.lock IS committed: this is a binary crate shipping a TLS/crypto tree
# (ureq+rustls+ring), so the dependency graph is pinned for reproducible,
# auditable builds of the public auto-updating miner.
logs/

# Wallet / key files — contain private keys, never commit to a public repo
csd-wallet.txt
*wallet*.txt
*.key

# Internal planning/design scaffolding (superpowers implementation plans + specs).
# Development process artifacts, never part of the public miner repo — ignored so
# a stray `git add -A` can't leak them. (Tracked docs live at the repo root:
# README.md, CHANGELOG.md, config.example.toml.)
/docs/superpowers/

# Agent/session scaffolding + local release helpers — never part of the public
# repo. RELEASE-*.bat embeds the production pool host; *-matrix.md planning docs
# name it too. Ignored so a stray `git add -A` can't leak them.
.claude/
RELEASE-*.bat
/docs/*-matrix.md
.installed-variant
