# csd-pool-miner systemd EnvironmentFile — copy to /etc/csd-pool-miner.env
# (root-owned, mode 0640, group = the csdminer service account) and edit.
#
#   install -m 0640 deploy/systemd/csd-pool-miner.env.example /etc/csd-pool-miner.env
#   chown root:csdminer /etc/csd-pool-miner.env
#   $EDITOR /etc/csd-pool-miner.env   # set CSD_ADDRESS below
#
# systemd parses this as KEY=VALUE lines (no shell, no `export`, no quoting of
# the whole value). The unit's ExecStart expands ${CSD_ADDRESS}.

# REQUIRED — your addr20 payout address (40 lowercase hex; the optional 0x
# prefix is also accepted by the miner). The pool sends your rewards here.
CSD_ADDRESS=your40charhexaddr20goeshere0000000000000

# OPTIONAL — local telemetry port. The packaged unit already enables the
# read-only stats endpoint on 127.0.0.1:3380 by default (bound to localhost, so
# it is NOT reachable off-box); query it with
#   curl -s 127.0.0.1:3380/1/summary
# to read per-rig hashrate windows, shares_good, reconnects and failovers.
# Uncomment to bind a different port (the unit's Environment= default is 3380).
# On a multi-GPU rig each card needs its own port — put e.g. CSD_STATS_PORT=3381
# in /etc/csd-pool-miner.1.env for GPU 1, etc.
#CSD_STATS_PORT=3380

# The unit's ExecStart references ${CSD_ADDRESS} only. If you want to pass extra
# miner flags, the simplest path is to add them directly to ExecStart in a
# systemd drop-in:
#   systemctl edit csd-pool-miner          # creates an override.conf
# and put, e.g.:
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/csd-pool-miner --address ${CSD_ADDRESS} --backend cuda --device 0
